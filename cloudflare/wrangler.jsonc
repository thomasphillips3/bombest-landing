// bom.best home page and bom.best/audio store, on the PM's Cloudflare account.
// bom.best is proxied through Cloudflare to an S3/CloudFront site; the Worker
// answers only the root and /audio paths and passes the rest (/beats included)
// through untouched.
//
// Build the assets first (the deploy script does it, after the config check):
//   npm run deploy:worker        (from the repo root)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bombest-audio-store",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // One wildcard route: an exact "bom.best/" route misses the root with a query
  // string (?utm_source=...), so the Worker sees every bom.best request and
  // passes anything that isn't the root or /audio straight to the origin.
  "routes": [{ "pattern": "bom.best/*", "zone_name": "bom.best" }],
  "assets": {
    "directory": "../dist/bom-best",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
